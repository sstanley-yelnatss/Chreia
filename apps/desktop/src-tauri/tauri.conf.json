{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chreia",
  "version": "0.1.0",
  "identifier": "com.contextlayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chreia",
        "width": 1100,
        "height": 720,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/contextlayer-recorder",
      "binaries/contextlayer-mcp",
      "binaries/contextlayer-trace"
    ],
    "resources": {
      "../../../.contextlayer/rules.yml": "trace-rules.yml"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
