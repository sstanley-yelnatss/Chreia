# Public Chreia site (share links + export footer). No trailing slash.
# Default if unset: https://chreia.vercel.app
VITE_CHREIA_PUBLIC_URL=https://chreia.vercel.app

# Must match CHREIA_SHARE_PUBLISH_KEY on the site (Vercel env).
# Leave empty only for local site with publish key unset (dev).
VITE_CHREIA_SHARE_PUBLISH_KEY=
